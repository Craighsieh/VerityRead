{
  "name": "verityread",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first local AI browser assistant for Chrome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:egress": "playwright test tests/e2e/egress.spec.ts",
    "capture:store": "tsx scripts/capture_store_screenshots.ts && python3 scripts/compose_store_screenshots.py",
    "qa:locales": "tsx scripts/qa_locales_anthropic.ts",
    "scan:dist": "tsx scripts/scan-dist.ts",
    "lint": "eslint src tests scripts manifest.config.ts vite.config.ts playwright.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "pipeline": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm scan:dist"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.287",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
