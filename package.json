{
  "name": "vaultlens",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first local AI browser assistant for Chrome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:egress": "playwright test tests/e2e/egress.spec.ts",
    "scan:dist": "tsx scripts/scan-dist.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "pipeline": "pnpm typecheck && pnpm test && pnpm build && pnpm scan:dist"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.287",
    "@types/mozilla__readability": "^0.4.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
